+/**
+ * Sums the amount of every transaction matching a given type (income or expense).
+ * Used to compute totals like "total income this month" or "total expenses this month".
+ */
 export function calculateTotalByType(transactions: Transaction[], type: TransactionType): number {
   return transactions
     .filter((t) => t.type === type)
     .reduce((sum, t) => sum + (Number(t.amount) || 0), 0);
 }
 
